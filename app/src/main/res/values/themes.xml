<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 窗口主题只负责启动瞬间的底色，真正的界面由 Compose 绘制 -->
    <style name="Theme.PengWa" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Compose owns both palettes; preserve its colors in the light-themed host window. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
